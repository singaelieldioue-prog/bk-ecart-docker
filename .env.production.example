# Copier ce fichier en .env à la racine du projet sur le serveur, puis adapter les valeurs.
# NE JAMAIS committer le .env réel.

# Port interne de l'API (utilisé par nginx via backend:4000 — ne pas changer sans adapter nginx.conf)
PORT=4000

# Secret JWT — à remplacer par une chaîne aléatoire longue : openssl rand -hex 32
JWT_SECRET=a_remplacer_par_openssl_rand_hex_32
JWT_EXPIRES=12h

# Origine autorisée : URL publique du serveur interne, ex. http://ecart.intranethe.bk  ou vide si accès par IP uniquement
CORS_ORIGIN=

# Mots de passe initiaux des comptes (uniquement au tout premier démarrage, à changer dans l'app ensuite)
SEED_CDG_PW=changez_moi
SEED_DAF_PW=changez_moi
SEED_DG_PW=changez_moi
SEED_ADMIN_PW=changez_moi
