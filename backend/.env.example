# Copiez ce fichier en .env et adaptez les valeurs.

# Port d'écoute de l'API
PORT=4000

# Secret de signature des jetons JWT — METTEZ UNE VALEUR LONGUE ET ALÉATOIRE EN PRODUCTION
# (ex. : openssl rand -hex 32)
JWT_SECRET=CHANGEZ_MOI_par_une_chaine_aleatoire_longue
JWT_EXPIRES=12h

# Origines autorisées (CORS). En production, mettez l'URL du front, ex. https://ecart.mon-domaine.ci
# Laisser vide autorise toutes les origines (pratique en dev).
CORS_ORIGIN=

# Chemin du fichier SQLite (par défaut : ./data.db)
DB_PATH=./data.db

# Mots de passe initiaux des comptes créés au premier démarrage (à changer ensuite)
SEED_CDG_PW=cdg123
SEED_DAF_PW=daf123
SEED_DG_PW=dg123
SEED_ADMIN_PW=admin123
